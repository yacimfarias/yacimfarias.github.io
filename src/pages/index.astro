---
import Layout from '../layouts/Layout.astro';
const topics = ['História da ciência', 'Ensino de biologia', 'Educação antiopressiva', 'História das mulheres na ciência', 'Racismo científico e eugenia', 'Humanidades digitais', 'Design Research'];
---
<Layout title="Yaci Farias">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Pesquisa · educação · história da ciência</p>
      <h1>Ciência também se ensina contando suas histórias.</h1>
      <p class="lede">Yaci Farias pesquisa as relações entre história da ciência, ensino de biologia e educação antiopressiva.</p>
      <a class="button" href="/sobre">Conheça a trajetória →</a>
    </div>
    <div class="hero-art">
      <div class="shape one"></div><div class="shape two"></div><div class="shape three"></div><div class="shape four"></div><div class="star" aria-hidden="true">✳</div>
      <figure class="portrait-frame">
        <img src="/images/yaci-farias.jpeg" alt="Yaci Farias sorrindo diante do mar" />
        <figcaption>Yaci Farias</figcaption>
      </figure>
    </div>
  </section>
  <section class="section section-grid">
    <div><p class="eyebrow">Áreas de interesse</p><h2>Perguntas que atravessam a pesquisa.</h2></div>
    <ul class="topic-list">{topics.map((topic) => <li>{topic}</li>)}</ul>
  </section>
  <section class="section">
    <p class="eyebrow">Percursos</p><h2>Pesquisa em movimento</h2>
    <div class="cards">
      <a class="card card-link" href="/pesquisa/"><h3>Pesquisa <span aria-hidden="true">↗</span></h3><p>História e ensino de ciências e biologia, com atenção às disputas de gênero, raça e poder.</p></a>
      <a class="card card-link" href="/sobre/#formacao"><h3>Formação <span aria-hidden="true">↗</span></h3><p>Experiências entre a escola, a universidade e a formação de professoras e professores.</p></a>
      <a class="card card-link" href="/publicacoes/"><h3>Divulgação <span aria-hidden="true">↗</span></h3><p>Conhecimento científico como prática pública, crítica e comprometida com a equidade.</p></a>
    </div>
  </section>
</Layout>
